{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://performing-fire-corpus.invalid/schemas/v1/evaluation-run.json",
  "title": "Reproducible corpus evaluation run v1",
  "$comment": "This schema binds the run envelope, its exact input snapshot, and its policy versions. Every nested finding is additionally admitted against its own strict record schema by performing_fire_corpus.evaluation.validate_evaluation_run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "evaluation_run_id",
    "evaluated_at",
    "evaluation_policy_version",
    "input_snapshot",
    "metrics",
    "coverage_gaps",
    "duplicate_findings",
    "quality_findings",
    "retrieval_cases",
    "recommendations",
    "caveats"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "evaluation_run"},
    "evaluation_run_id": {"type": "string", "pattern": "^evaluation_run_[0-9a-f]{24}$"},
    "evaluated_at": {"$ref": "#/$defs/time"},
    "evaluation_policy_version": {"$ref": "#/$defs/policyVersion"},
    "input_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completeness_report_ids",
        "discovery_run_ids",
        "policy_snapshot_ids",
        "selection_manifest_id",
        "selection_policy_version",
        "inventory_snapshot_sha256",
        "corpus_index_id",
        "index_snapshot_id",
        "index_sha256",
        "snapshot_sha256",
        "policy_snapshot_sha256"
      ],
      "properties": {
        "completeness_report_ids": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 256,
          "items": {"type": "string", "pattern": "^completeness_report_[a-z0-9][a-z0-9._-]{0,160}$"}
        },
        "discovery_run_ids": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 256,
          "items": {"type": "string", "pattern": "^discovery_run_[a-z0-9][a-z0-9._-]{0,127}$"}
        },
        "policy_snapshot_ids": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 256,
          "items": {"type": "string", "pattern": "^policy_snapshot_[a-z0-9][a-z0-9._-]{0,127}$"}
        },
        "selection_manifest_id": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^selection_manifest_[0-9a-f]{24}$"}
          ]
        },
        "selection_policy_version": {
          "anyOf": [{"type": "null"}, {"$ref": "#/$defs/policyVersion"}]
        },
        "inventory_snapshot_sha256": {"$ref": "#/$defs/nullableHash"},
        "corpus_index_id": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^corpus_index_[a-z0-9][a-z0-9._-]{0,127}$"}
          ]
        },
        "index_snapshot_id": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^index_snapshot_[a-z0-9][a-z0-9._-]{0,127}$"}
          ]
        },
        "index_sha256": {"$ref": "#/$defs/nullableHash"},
        "snapshot_sha256": {"$ref": "#/$defs/nullableHash"},
        "policy_snapshot_sha256": {"$ref": "#/$defs/nullableHash"}
      }
    },
    "metrics": {"$ref": "#/$defs/records"},
    "coverage_gaps": {"$ref": "#/$defs/records"},
    "duplicate_findings": {"$ref": "#/$defs/records"},
    "quality_findings": {"$ref": "#/$defs/records"},
    "retrieval_cases": {"$ref": "#/$defs/records"},
    "recommendations": {"$ref": "#/$defs/records"},
    "caveats": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/safeText"}
    }
  },
  "$defs": {
    "nullableHash": {
      "anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]
    },
    "policyVersion": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "records": {"type": "array", "maxItems": 4096, "items": {"type": "object"}},
    "time": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "safeText": {"type": "string", "format": "performing-fire-sanitized-text-v1", "minLength": 1, "maxLength": 512, "pattern": "^(?!.*(?:[Xx]-[Aa]mz-|[Ff]ull source prose))(?!.*[\\r\\n])[A-Za-z0-9 .,!?;'\"()\\[\\]{}_+\\-\\u00B7\\u00C0-\\u024F\\u1E00-\\u1EFF\\u3001\\u3002\\u300C\\u300D\\u3040-\\u3098\\u309B-\\u30FF\\u3400-\\u4DBF\\u4E00-\\u9FFF\\uAC00-\\uD7A3\\u2013\\u2014\\u2018-\\u201D\\u2026\\uFF08\\uFF09]+$"}
  }
}
