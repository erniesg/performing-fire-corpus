{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://performing-fire-corpus.invalid/schemas/v1/retention-authority.json",
  "title": "Current retention and legal-hold authority v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "authority_id",
    "source_id",
    "asset_id",
    "retention_class",
    "expires_at",
    "legal_hold_state",
    "legal_hold_basis_sha256",
    "decided_at",
    "valid_until",
    "evidence_ref",
    "authority_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "retention_authority"},
    "authority_id": {
      "type": "string",
      "pattern": "^retention_authority_[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^(?:source_[a-z0-9][a-z0-9._-]{0,127}|[a-z]+(?:-[a-z]+)*)$"
    },
    "asset_id": {
      "type": "string",
      "pattern": "^asset_[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "retention_class": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "expires_at": {"$ref": "#/$defs/utc_seconds"},
    "legal_hold_state": {"enum": ["none", "active"]},
    "legal_hold_basis_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "decided_at": {"$ref": "#/$defs/utc_seconds"},
    "valid_until": {"$ref": "#/$defs/utc_seconds"},
    "evidence_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "authority_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"legal_hold_state": {"const": "active"}},
        "required": ["legal_hold_state"]
      },
      "then": {
        "properties": {
          "legal_hold_basis_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "else": {
        "properties": {"legal_hold_basis_sha256": {"type": "null"}}
      }
    }
  ],
  "$defs": {
    "utc_seconds": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
