{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://performing-fire-corpus.invalid/schemas/v1/derivation-manifest.json",
  "title": "Raw-to-derived corpus manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "manifest_id",
    "source_id",
    "asset_id",
    "transformation_id",
    "tool_id",
    "tool_version",
    "contract_version",
    "parameters",
    "parameters_sha256",
    "input_receipt_ids",
    "input_object_keys",
    "input_sha256",
    "output_receipt_ids",
    "output_object_keys",
    "output_sha256",
    "input_rights_snapshot_sha256",
    "output_rights_snapshot_sha256",
    "rights_inheritance",
    "effective_retrieval_decision",
    "effective_rights_snapshot_sha256",
    "redaction_state",
    "evidence_ref",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "derivation_manifest"},
    "manifest_id": {
      "type": "string",
      "pattern": "^manifest_[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^source_[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "asset_id": {
      "type": "string",
      "pattern": "^asset_[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "transformation_id": {
      "type": "string",
      "pattern": "^transform_[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "tool_id": {
      "type": "string",
      "pattern": "^tool_[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "tool_version": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}(?:[-+][a-z0-9.-]+)?$"
    },
    "contract_version": {
      "type": "integer",
      "minimum": 1
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "confidence_threshold_milli": {"type": "integer"},
        "language": {"type": "string"},
        "model_id": {"type": "string"},
        "output_format": {"type": "string"},
        "profile_id": {"type": "string"},
        "sample_rate_hz": {"type": "integer"},
        "segment_seconds": {"type": "integer"},
        "task": {"type": "string"},
        "temperature_milli": {"type": "integer"}
      }
    },
    "parameters_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_receipt_ids": {"$ref": "#/$defs/receipt_ids"},
    "input_object_keys": {"$ref": "#/$defs/object_keys"},
    "input_sha256": {"$ref": "#/$defs/hashes"},
    "output_receipt_ids": {"$ref": "#/$defs/receipt_ids"},
    "output_object_keys": {"$ref": "#/$defs/object_keys"},
    "output_sha256": {"$ref": "#/$defs/hashes"},
    "input_rights_snapshot_sha256": {"$ref": "#/$defs/hashes"},
    "output_rights_snapshot_sha256": {"$ref": "#/$defs/hashes"},
    "rights_inheritance": {"const": "most_restrictive"},
    "effective_retrieval_decision": {
      "enum": ["approved", "metadata_only", "blocked"]
    },
    "effective_rights_snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "redaction_state": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "evidence_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "receipt_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^receipt_[a-z0-9][a-z0-9._-]{0,127}$"
      }
    },
    "object_keys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[a-z0-9][a-z0-9._/-]{0,511}$"
      }
    },
    "hashes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  }
}
