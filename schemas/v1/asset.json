{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://performing-fire-corpus.invalid/schemas/v1/asset.json",
  "title": "Asset record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "asset_id",
    "source_id",
    "public_url",
    "media_type",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "asset"
    },
    "asset_id": {
      "type": "string",
      "pattern": "^asset_[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^(?:source_[a-z0-9][a-z0-9._-]{0,127}|[a-z]+(?:-[a-z]+)*)$"
    },
    "public_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/\\s]+(?:/[^\\s]*)?$",
      "maxLength": 2048
    },
    "media_type": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,63}/[a-z0-9][a-z0-9!#$&^_.+-]{0,63}$"
    },
    "byte_size": {
      "type": "integer",
      "minimum": 0
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "metadata": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^(?!.*(?:/home/|/Users/|/tmp/|[A-Za-z]:[\\\\/]|file://))[^\\r\\n]+$"
      }
    }
  },
  "dependentRequired": {
    "sha256": [
      "byte_size"
    ]
  }
}
