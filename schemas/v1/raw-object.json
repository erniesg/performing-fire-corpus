{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://performing-fire-corpus.invalid/schemas/v1/raw-object.json",
  "title": "Raw corpus object v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "source_id",
    "asset_id",
    "object_key",
    "sha256",
    "byte_size",
    "media_type",
    "rights_snapshot_sha256",
    "retention_class",
    "retrieval_decision"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "raw_object"},
    "source_id": {
      "type": "string",
      "pattern": "^source_[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "asset_id": {
      "type": "string",
      "pattern": "^asset_[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "object_key": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[a-z0-9][a-z0-9._/-]{0,511}/v1/raw/source_[a-z0-9._-]+/asset_[a-z0-9._-]+/[0-9a-f]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "byte_size": {
      "type": "integer",
      "minimum": 0
    },
    "media_type": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,63}/[a-z0-9][a-z0-9!#$&^_.+-]{0,63}$"
    },
    "rights_snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "retention_class": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "retrieval_decision": {
      "enum": ["approved", "metadata_only", "blocked"]
    }
  }
}
