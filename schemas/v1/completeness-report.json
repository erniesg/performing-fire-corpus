{
  "$id": "https://performing-fire-corpus.invalid/schemas/v1/completeness-report.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "nullableCount": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "properties": {
    "adapter_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "type": "string"
    },
    "blocked_pages": {
      "minimum": 0,
      "type": "integer"
    },
    "duplicate_records": {
      "minimum": 0,
      "type": "integer"
    },
    "endpoint_id": {
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "expected_total": {
      "$ref": "#/$defs/nullableCount"
    },
    "generated_at": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "observed_unique_records": {
      "minimum": 0,
      "type": "integer"
    },
    "pages_committed": {
      "minimum": 0,
      "type": "integer"
    },
    "policy_snapshot_id": {
      "pattern": "^policy_snapshot_[a-z0-9][a-z0-9._-]{0,127}$",
      "type": "string"
    },
    "record_type": {
      "const": "completeness_report"
    },
    "rejected_records": {
      "minimum": 0,
      "type": "integer"
    },
    "report_id": {
      "pattern": "^completeness_report_[a-z0-9][a-z0-9._-]{0,160}$",
      "type": "string"
    },
    "requests_attempted": {
      "minimum": 0,
      "type": "integer"
    },
    "run_id": {
      "pattern": "^discovery_run_[a-z0-9][a-z0-9._-]{0,127}$",
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "source_id": {
      "pattern": "^[a-z]+(?:-[a-z]+)*$",
      "type": "string"
    },
    "state": {
      "enum": [
        "blocked",
        "bounded_partial",
        "changed",
        "complete_for_observed_endpoint",
        "unknown"
      ]
    },
    "stop_reason": {
      "enum": [
        "adapter_limit_mismatch",
        "aggregate_byte_budget_exhausted",
        "ambiguous_terminal",
        "elapsed_budget_exhausted",
        "expected_total_changed",
        "http_error",
        "invalid_response_time",
        "page_budget_exhausted",
        "pagination_loop",
        "policy_expired",
        "policy_ineligible",
        "record_changed",
        "request_budget_exhausted",
        "response_oversized",
        "retry_exhausted",
        "robots_expired",
        "run_plan_changed",
        "shape_drift",
        "terminal_page",
        "transport_error",
        "unsafe_cursor"
      ]
    },
    "terminal_pages": {
      "minimum": 0,
      "type": "integer"
    },
    "unvisited_remainder": {
      "$ref": "#/$defs/nullableCount"
    }
  },
  "required": [
    "adapter_version",
    "blocked_pages",
    "duplicate_records",
    "endpoint_id",
    "expected_total",
    "generated_at",
    "observed_unique_records",
    "pages_committed",
    "policy_snapshot_id",
    "record_type",
    "rejected_records",
    "report_id",
    "requests_attempted",
    "run_id",
    "schema_version",
    "source_id",
    "state",
    "stop_reason",
    "terminal_pages",
    "unvisited_remainder"
  ],
  "title": "Evidence-scoped discovery completeness report v1",
  "type": "object"
}
