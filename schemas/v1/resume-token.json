{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://performing-fire-corpus.invalid/schemas/v1/resume-token.json",
  "title": "Durable resumable checkpoint token v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "resume_token_id",
    "checkpoint",
    "checkpoint_sha256",
    "issued_at",
    "expires_at",
    "operation",
    "subject_ids",
    "lane",
    "policy_version",
    "attempt",
    "bound_consumption",
    "outcome_code",
    "evidence_time"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "resume_token"},
    "resume_token_id": {"type": "string", "pattern": "^resume_token_[0-9a-f]{24}$"},
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cursor",
        "next_ordinal",
        "processed_count",
        "last_stable_id",
        "attempt"
      ],
      "properties": {
        "cursor": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^(?:page|offset)-[0-9]{1,18}$"}
          ]
        },
        "next_ordinal": {
          "anyOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]
        },
        "processed_count": {"type": "integer", "minimum": 0},
        "last_stable_id": {
          "anyOf": [{"type": "null"}, {"$ref": "#/$defs/stableId"}]
        },
        "attempt": {"type": "integer", "minimum": 1, "maximum": 1024}
      }
    },
    "checkpoint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "issued_at": {"$ref": "#/$defs/instant"},
    "expires_at": {"$ref": "#/$defs/instant"},
    "operation": {"$ref": "#/$defs/operation"},
    "subject_ids": {"$ref": "#/$defs/subjectIds"},
    "lane": {"$ref": "#/$defs/lane"},
    "policy_version": {"$ref": "#/$defs/policyVersion"},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 1024},
    "bound_consumption": {"$ref": "#/$defs/boundConsumption"},
    "outcome_code": {"const": "checkpoint_committed"},
    "evidence_time": {"$ref": "#/$defs/instant"}
  },
  "$defs": {
    "instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "operation": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "policyVersion": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "lane": {
      "enum": [
        "portable",
        "network-acquisition",
        "trusted-vm",
        "trusted-laptop",
        "object-storage",
        "deploy",
        "sandbox"
      ]
    },
    "stableId": {
      "type": "string",
      "pattern": "^(?:(?:asset|contribution|discovery_run|job|lease|object|rights|run|source|worker)_[a-z0-9][a-z0-9._-]{0,127}|[a-z][a-z0-9]*(?:-[a-z0-9]+)*)$"
    },
    "subjectIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/stableId"}
    },
    "boundConsumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "bytes", "pages", "retries", "elapsed_seconds"],
      "properties": {
        "requests": {"type": "integer", "minimum": 0},
        "bytes": {"type": "integer", "minimum": 0},
        "pages": {"type": "integer", "minimum": 0},
        "retries": {"type": "integer", "minimum": 0},
        "elapsed_seconds": {"type": "number", "minimum": 0}
      }
    }
  }
}
