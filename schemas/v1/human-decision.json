{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://performing-fire-corpus.invalid/schemas/v1/human-decision.json",
  "title": "Human gate decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "decision_id",
    "blocker_id",
    "decision",
    "decision_reason_code",
    "granted_authority_class",
    "review_trigger",
    "decided_at",
    "expires_at",
    "resume_token_id",
    "operation",
    "subject_ids",
    "lane",
    "policy_version",
    "attempt",
    "bound_consumption",
    "outcome_code",
    "evidence_time"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "human_decision"},
    "decision_id": {"type": "string", "pattern": "^human_decision_[0-9a-f]{24}$"},
    "blocker_id": {"type": "string", "pattern": "^operator_blocker_[0-9a-f]{24}$"},
    "decision": {"enum": ["granted", "denied", "deferred"]},
    "decision_reason_code": {
      "enum": [
        "authority_recorded",
        "authority_withheld",
        "authority_out_of_scope",
        "awaiting_further_review",
        "blocker_expired"
      ]
    },
    "granted_authority_class": {
      "anyOf": [{"type": "null"}, {"$ref": "#/$defs/authorityClass"}]
    },
    "review_trigger": {"$ref": "#/$defs/safeText"},
    "decided_at": {"$ref": "#/$defs/instant"},
    "expires_at": {
      "anyOf": [{"type": "null"}, {"$ref": "#/$defs/instant"}]
    },
    "resume_token_id": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^resume_token_[0-9a-f]{24}$"}
      ]
    },
    "operation": {"$ref": "#/$defs/operation"},
    "subject_ids": {"$ref": "#/$defs/subjectIds"},
    "lane": {"$ref": "#/$defs/lane"},
    "policy_version": {"$ref": "#/$defs/policyVersion"},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 1024},
    "bound_consumption": {"$ref": "#/$defs/boundConsumption"},
    "outcome_code": {"$ref": "#/$defs/outcomeCode"},
    "evidence_time": {"$ref": "#/$defs/instant"}
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "granted"}}},
      "then": {
        "properties": {
          "decision_reason_code": {"const": "authority_recorded"},
          "granted_authority_class": {"$ref": "#/$defs/authorityClass"},
          "expires_at": {"$ref": "#/$defs/instant"},
          "resume_token_id": {
            "type": "string",
            "pattern": "^resume_token_[0-9a-f]{24}$"
          }
        }
      }
    },
    {
      "if": {"properties": {"decision": {"const": "denied"}}},
      "then": {
        "properties": {
          "granted_authority_class": {"type": "null"},
          "resume_token_id": {"type": "null"},
          "decision_reason_code": {
            "enum": ["authority_withheld", "authority_out_of_scope"]
          }
        }
      }
    },
    {
      "if": {"properties": {"decision": {"const": "deferred"}}},
      "then": {
        "properties": {
          "granted_authority_class": {"type": "null"},
          "decision_reason_code": {
            "enum": ["awaiting_further_review", "blocker_expired"]
          },
          "resume_token_id": {
            "type": "string",
            "pattern": "^resume_token_[0-9a-f]{24}$"
          }
        }
      }
    }
  ],
  "$defs": {
    "safeText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!.*(?:/home/|/Users/|/tmp/|file://|[A-Za-z]:[\\\\/]))[^\\r\\n]+$"
    },
    "authorityClass": {
      "enum": [
        "source_governance_approval",
        "rights_approval",
        "retention_approval",
        "privacy_approval",
        "transformation_approval",
        "object_storage_authority",
        "actions_spending_authority",
        "network_acquisition_approval",
        "trusted_laptop_pairing",
        "deploy_approval"
      ]
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "operation": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "policyVersion": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "lane": {
      "enum": [
        "portable",
        "network-acquisition",
        "trusted-vm",
        "trusted-laptop",
        "object-storage",
        "deploy",
        "sandbox"
      ]
    },
    "stableId": {
      "type": "string",
      "pattern": "^(?:(?:asset|contribution|discovery_run|job|lease|object|rights|run|source|worker)_[a-z0-9][a-z0-9._-]{0,127}|[a-z][a-z0-9]*(?:-[a-z0-9]+)*)$"
    },
    "subjectIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/stableId"}
    },
    "boundConsumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "bytes", "pages", "retries", "elapsed_seconds"],
      "properties": {
        "requests": {"type": "integer", "minimum": 0},
        "bytes": {"type": "integer", "minimum": 0},
        "pages": {"type": "integer", "minimum": 0},
        "retries": {"type": "integer", "minimum": 0},
        "elapsed_seconds": {"type": "number", "minimum": 0}
      }
    },
    "outcomeCode": {
      "enum": ["succeeded", "blocked_on_human", "failed_closed"]
    }
  }
}
