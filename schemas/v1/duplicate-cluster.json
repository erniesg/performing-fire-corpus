{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://performing-fire-corpus.invalid/schemas/v1/duplicate-cluster.json",
  "title": "Provenance-preserving duplicate cluster v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "duplicate_cluster_id", "canonicalization_version", "evidence_summary", "members"],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "duplicate_cluster"},
    "duplicate_cluster_id": {"type": "string", "pattern": "^duplicate_cluster_[a-z0-9][a-z0-9._-]{0,127}$"},
    "canonicalization_version": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "evidence_summary": {"$ref": "#/$defs/safeText"},
    "members": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/member"}}
  },
  "$defs": {
    "safeText": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?!.*(?:[Xx]-[Aa]mz-|[Ff]ull source prose))(?!.*(?:(?:[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn] +(?:(?:[Bb][Aa][Ss][Ii][Cc]|[Bb][Ee][Aa][Rr][Ee][Rr]) +)?|[Bb][Aa][Ss][Ii][Cc] +|[Bb][Ee][Aa][Rr][Ee][Rr] +|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll][Ss]? +|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd] +|[Tt][Oo][Kk][Ee][Nn] +|[Aa][Pp][Ii] +[Kk][Ee][Yy] +|(?:[Aa][Ww][Ss] +)?[Ss][Ee][Cc][Rr][Ee][Tt] +[Aa][Cc][Cc][Ee][Ss][Ss] +[Kk][Ee][Yy] +|[Cc][Ll][Ii][Ee][Nn][Tt] +[Ss][Ee][Cc][Rr][Ee][Tt] +|[Gg][Ii][Tt][Hh][Uu][Bb] +[Tt][Oo][Kk][Ee][Nn] +|[Jj][Ww][Tt] +)(?:(?=[A-Za-z0-9._+/=-]{0,255}[0-9._+/=-])[A-Za-z0-9._+/=-]{16,}|(?=[A-Za-z0-9._-]{0,255}[A-Z][A-Za-z0-9._-]*[A-Z])[A-Za-z0-9._-]{20,}|([A-Za-z]{4,16})\\1{1,}|(?![A-Za-z]*([A-Za-z])(?:[A-Za-z]*\\2){2})[A-Za-z]{24,40})|(?:AKIA|ASIA)[A-Z0-9]{16}|(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|eyJ[A-Za-z0-9_-]{5,}\\.[A-Za-z0-9_-]{2,}\\.[A-Za-z0-9_-]{8,}))(?!.*[\\r\\n])[A-Za-z0-9 .,!?;'\"()\\[\\]{}_+\\-\\u00B7\\u00C0-\\u024F\\u1E00-\\u1EFF\\u3001\\u3002\\u300C\\u300D\\u3040-\\u3098\\u309B-\\u30FF\\u3400-\\u4DBF\\u4E00-\\u9FFF\\uAC00-\\uD7A3\\u2013\\u2014\\u2018-\\u201D\\u2026\\uFF08\\uFF09]+$"},
    "sourceId": {"enum": ["antiegg-fluxus", "njp-center-main", "njp-center-video-archive", "njp-video-library", "njp-youtube-official", "project-native-artist-submissions", "project-native-generated-scores", "project-native-performer-annotations", "project-native-visitor-inputs", "project-native-visual-system-state"]},
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index_document_id", "source_id", "asset_id", "provenance_edge_ids"],
      "properties": {
        "index_document_id": {"type": "string", "pattern": "^index_document_[a-z0-9][a-z0-9._-]{0,127}$"},
        "source_id": {"$ref": "#/$defs/sourceId"},
        "asset_id": {"type": "string", "pattern": "^asset_[a-z0-9][a-z0-9._-]{0,127}$"},
        "provenance_edge_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^provenance_edge_[a-z0-9][a-z0-9._-]{0,159}$"}}
      }
    }
  }
}
