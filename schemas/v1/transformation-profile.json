{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://performing-fire-corpus.invalid/schemas/v1/transformation-profile.json",
  "title": "Operation-specific derived-media transformation profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "profile_id",
    "profile_version",
    "operation",
    "contract_version",
    "allowed_tool_classes",
    "allowed_tool_ids",
    "minimum_tool_version",
    "maximum_tool_version",
    "allowed_input_media_types",
    "allowed_languages",
    "output_record_type",
    "output_schema_id",
    "output_media_type",
    "resource_bounds",
    "retention_class",
    "redaction_state",
    "maximum_retrieval_decision",
    "minimum_confidence_milli",
    "external_service_policy",
    "model_trace_retention",
    "profile_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "transformation_profile"},
    "profile_id": {
      "type": "string",
      "pattern": "^profile_[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "profile_version": {"type": "integer", "minimum": 1},
    "operation": {
      "enum": ["ocr", "transcription", "video_understanding"]
    },
    "contract_version": {"type": "integer", "minimum": 1},
    "allowed_tool_classes": {"$ref": "#/$defs/labels"},
    "allowed_tool_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^tool_[a-z0-9][a-z0-9._-]{0,127}$"
      }
    },
    "minimum_tool_version": {"$ref": "#/$defs/version"},
    "maximum_tool_version": {"$ref": "#/$defs/version"},
    "allowed_input_media_types": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,63}/[a-z0-9][a-z0-9!#$&^_.+-]{0,63}$"
      }
    },
    "allowed_languages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(?:-[a-z0-9]{2,8}){0,3}$"
      }
    },
    "output_record_type": {
      "enum": ["ocr_result", "transcription_result", "video_understanding_result"]
    },
    "output_schema_id": {
      "enum": [
        "https://performing-fire-corpus.invalid/schemas/v1/ocr-result.json",
        "https://performing-fire-corpus.invalid/schemas/v1/transcription-result.json",
        "https://performing-fire-corpus.invalid/schemas/v1/video-understanding-result.json"
      ]
    },
    "output_media_type": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,63}/[a-z0-9][a-z0-9!#$&^_.+-]{0,63}$"
    },
    "resource_bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_input_bytes",
        "maximum_output_bytes",
        "maximum_cpu_seconds",
        "maximum_memory_bytes",
        "maximum_disk_bytes",
        "maximum_elapsed_seconds"
      ],
      "properties": {
        "maximum_input_bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824},
        "maximum_output_bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824},
        "maximum_cpu_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "maximum_memory_bytes": {"type": "integer", "minimum": 1, "maximum": 137438953472},
        "maximum_disk_bytes": {"type": "integer", "minimum": 1, "maximum": 1099511627776},
        "maximum_elapsed_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
      }
    },
    "retention_class": {
      "enum": [
        "inventory_metadata",
        "project_native_expiring",
        "selected_derived",
        "selected_raw"
      ]
    },
    "redaction_state": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "maximum_retrieval_decision": {
      "enum": ["approved", "metadata_only", "blocked"]
    },
    "minimum_confidence_milli": {"type": "integer", "minimum": 0, "maximum": 1000},
    "external_service_policy": {"const": "local_offline_only"},
    "model_trace_retention": {"const": "none"},
    "profile_sha256": {"$ref": "#/$defs/hash"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"operation": {"const": "ocr"}},
        "required": ["operation"]
      },
      "then": {
        "properties": {
          "output_record_type": {"const": "ocr_result"},
          "output_schema_id": {
            "const": "https://performing-fire-corpus.invalid/schemas/v1/ocr-result.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {"operation": {"const": "transcription"}},
        "required": ["operation"]
      },
      "then": {
        "properties": {
          "output_record_type": {"const": "transcription_result"},
          "output_schema_id": {
            "const": "https://performing-fire-corpus.invalid/schemas/v1/transcription-result.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {"operation": {"const": "video_understanding"}},
        "required": ["operation"]
      },
      "then": {
        "properties": {
          "output_record_type": {"const": "video_understanding_result"},
          "output_schema_id": {
            "const": "https://performing-fire-corpus.invalid/schemas/v1/video-understanding-result.json"
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "version": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}(?:[-+][a-z0-9.-]+)?$"
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
      }
    }
  }
}
