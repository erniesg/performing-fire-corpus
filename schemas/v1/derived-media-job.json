{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://performing-fire-corpus.invalid/schemas/v1/derived-media-job.json",
  "title": "Admitted rights-aware derived-media job v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "job_id",
    "operation",
    "profile_id",
    "profile_version",
    "profile_sha256",
    "source_id",
    "asset_id",
    "input_object_key",
    "input_sha256",
    "input_byte_size",
    "input_media_type",
    "input_receipt_id",
    "qualification_id",
    "qualification_sha256",
    "rights_snapshot_sha256",
    "rights_decision_expires_at",
    "rights_state",
    "consent_state",
    "tool_id",
    "tool_class",
    "tool_version",
    "contract_version",
    "language_hint",
    "medium_hint",
    "resource_bounds",
    "output_record_type",
    "output_schema_id",
    "output_media_type",
    "retention_class",
    "retention_expires_at",
    "redaction_state",
    "retrieval_decision",
    "external_service_policy",
    "model_trace_retention",
    "evidence_ref",
    "queued_at",
    "job_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "derived_media_job"},
    "job_id": {
      "type": "string",
      "pattern": "^derivedjob_[a-z0-9]{24}$"
    },
    "operation": {
      "enum": ["ocr", "transcription", "video_understanding"]
    },
    "profile_id": {
      "type": "string",
      "pattern": "^profile_[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "profile_version": {"type": "integer", "minimum": 1},
    "profile_sha256": {"$ref": "#/$defs/hash"},
    "source_id": {
      "type": "string",
      "pattern": "^(?:source_[a-z0-9][a-z0-9._-]{0,127}|[a-z]+(?:-[a-z]+)*)$"
    },
    "asset_id": {
      "type": "string",
      "pattern": "^asset_[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "input_object_key": {"$ref": "#/$defs/object_key"},
    "input_sha256": {"$ref": "#/$defs/hash"},
    "input_byte_size": {"type": "integer", "minimum": 1, "maximum": 1073741824},
    "input_media_type": {"$ref": "#/$defs/media_type"},
    "input_receipt_id": {
      "type": "string",
      "pattern": "^receipt_[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "qualification_id": {
      "type": "string",
      "pattern": "^qualification_[a-z0-9]{24}$"
    },
    "qualification_sha256": {"$ref": "#/$defs/hash"},
    "rights_snapshot_sha256": {"$ref": "#/$defs/hash"},
    "rights_decision_expires_at": {"$ref": "#/$defs/time"},
    "rights_state": {"const": "approved"},
    "consent_state": {"enum": ["granted", "not_applicable"]},
    "tool_id": {
      "type": "string",
      "pattern": "^tool_[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "tool_class": {"$ref": "#/$defs/label"},
    "tool_version": {"$ref": "#/$defs/version"},
    "contract_version": {"type": "integer", "minimum": 1},
    "language_hint": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[a-z]{2,3}(?:-[a-z0-9]{2,8}){0,3}$"}
      ]
    },
    "medium_hint": {
      "anyOf": [{"type": "null"}, {"$ref": "#/$defs/label"}]
    },
    "resource_bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_input_bytes",
        "maximum_output_bytes",
        "maximum_cpu_seconds",
        "maximum_memory_bytes",
        "maximum_disk_bytes",
        "maximum_elapsed_seconds"
      ],
      "properties": {
        "maximum_input_bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824},
        "maximum_output_bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824},
        "maximum_cpu_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "maximum_memory_bytes": {"type": "integer", "minimum": 1, "maximum": 137438953472},
        "maximum_disk_bytes": {"type": "integer", "minimum": 1, "maximum": 1099511627776},
        "maximum_elapsed_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
      }
    },
    "output_record_type": {
      "enum": ["ocr_result", "transcription_result", "video_understanding_result"]
    },
    "output_schema_id": {
      "enum": [
        "https://performing-fire-corpus.invalid/schemas/v1/ocr-result.json",
        "https://performing-fire-corpus.invalid/schemas/v1/transcription-result.json",
        "https://performing-fire-corpus.invalid/schemas/v1/video-understanding-result.json"
      ]
    },
    "output_media_type": {"$ref": "#/$defs/media_type"},
    "retention_class": {
      "enum": ["project_native_expiring", "selected_derived"]
    },
    "retention_expires_at": {"$ref": "#/$defs/time"},
    "redaction_state": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "retrieval_decision": {
      "enum": ["approved", "metadata_only", "blocked"]
    },
    "external_service_policy": {"const": "local_offline_only"},
    "model_trace_retention": {"const": "none"},
    "evidence_ref": {"$ref": "#/$defs/evidence_ref"},
    "queued_at": {"$ref": "#/$defs/time"},
    "job_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "label": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}(?:[-+][a-z0-9.-]+)?$"
    },
    "media_type": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,63}/[a-z0-9][a-z0-9!#$&^_.+-]{0,63}$"
    },
    "object_key": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[a-z0-9][a-z0-9._/-]{0,511}$"
    }
  }
}
