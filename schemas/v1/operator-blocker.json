{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://performing-fire-corpus.invalid/schemas/v1/operator-blocker.json",
  "title": "Actionable operator blocker v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "blocker_id",
    "blocked_subject_id",
    "isolation_scope",
    "missing_authority_class",
    "question",
    "recommended_response",
    "next_safe_action",
    "unblocking_command_class",
    "review_trigger",
    "opened_at",
    "expires_at",
    "resume_token_id",
    "operation",
    "subject_ids",
    "lane",
    "policy_version",
    "attempt",
    "bound_consumption",
    "outcome_code",
    "evidence_time"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "operator_blocker"},
    "blocker_id": {"type": "string", "pattern": "^operator_blocker_[0-9a-f]{24}$"},
    "blocked_subject_id": {"$ref": "#/$defs/stableId"},
    "isolation_scope": {
      "enum": ["single_job", "single_endpoint", "single_source", "single_worker"]
    },
    "missing_authority_class": {"$ref": "#/$defs/authorityClass"},
    "question": {"$ref": "#/$defs/safeText"},
    "recommended_response": {"$ref": "#/$defs/safeText"},
    "next_safe_action": {"$ref": "#/$defs/safeText"},
    "unblocking_command_class": {
      "enum": [
        "record_source_governance_decision",
        "record_rights_decision",
        "record_retention_decision",
        "record_privacy_decision",
        "record_transformation_decision",
        "provision_object_storage_authority",
        "raise_actions_spending_authority",
        "approve_network_acquisition",
        "approve_trusted_laptop_pairing",
        "approve_deploy"
      ]
    },
    "review_trigger": {"$ref": "#/$defs/safeText"},
    "opened_at": {"$ref": "#/$defs/instant"},
    "expires_at": {"$ref": "#/$defs/instant"},
    "resume_token_id": {"type": "string", "pattern": "^resume_token_[0-9a-f]{24}$"},
    "operation": {"$ref": "#/$defs/operation"},
    "subject_ids": {"$ref": "#/$defs/subjectIds"},
    "lane": {"$ref": "#/$defs/lane"},
    "policy_version": {"$ref": "#/$defs/policyVersion"},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 1024},
    "bound_consumption": {"$ref": "#/$defs/boundConsumption"},
    "outcome_code": {"const": "blocked_on_human"},
    "evidence_time": {"$ref": "#/$defs/instant"}
  },
  "$defs": {
    "safeText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!.*(?:/home/|/Users/|/tmp/|file://|[A-Za-z]:[\\\\/]))[^\\r\\n]+$"
    },
    "authorityClass": {
      "enum": [
        "source_governance_approval",
        "rights_approval",
        "retention_approval",
        "privacy_approval",
        "transformation_approval",
        "object_storage_authority",
        "actions_spending_authority",
        "network_acquisition_approval",
        "trusted_laptop_pairing",
        "deploy_approval"
      ]
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "operation": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "policyVersion": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "lane": {
      "enum": [
        "portable",
        "network-acquisition",
        "trusted-vm",
        "trusted-laptop",
        "object-storage",
        "deploy",
        "sandbox"
      ]
    },
    "stableId": {
      "type": "string",
      "pattern": "^(?:(?:asset|contribution|discovery_run|job|lease|object|rights|run|source|worker)_[a-z0-9][a-z0-9._-]{0,127}|[a-z][a-z0-9]*(?:-[a-z0-9]+)*)$"
    },
    "subjectIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/stableId"}
    },
    "boundConsumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "bytes", "pages", "retries", "elapsed_seconds"],
      "properties": {
        "requests": {"type": "integer", "minimum": 0},
        "bytes": {"type": "integer", "minimum": 0},
        "pages": {"type": "integer", "minimum": 0},
        "retries": {"type": "integer", "minimum": 0},
        "elapsed_seconds": {"type": "number", "minimum": 0}
      }
    }
  }
}
