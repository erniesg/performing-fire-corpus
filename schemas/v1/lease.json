{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://performing-fire-corpus.invalid/schemas/v1/lease.json",
  "title": "Lease record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "lease_id",
    "job_id",
    "holder_id",
    "capabilities",
    "acquired_at",
    "expires_at",
    "checkpoint"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "lease"
    },
    "lease_id": {
      "type": "string",
      "pattern": "^lease_[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "job_id": {
      "type": "string",
      "pattern": "^job_[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "holder_id": {
      "type": "string",
      "pattern": "^worker_[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      }
    },
    "acquired_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "summary"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!.*(?:/home/|/Users/|/tmp/|[A-Za-z]:[\\\\/]|file://))[^\\r\\n]+$"
        },
        "object_key": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[A-Za-z0-9][A-Za-z0-9._/-]{0,511}$"
        }
      }
    }
  }
}
