{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://performing-fire-corpus.invalid/schemas/v1/score-feature-export.json",
  "title": "Rights-safe score-generation feature export v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "score_export_id", "corpus_index_id", "index_sha256", "policy_snapshot_sha256", "exported_at", "audience", "operation", "documents"],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "score_feature_export"},
    "score_export_id": {"type": "string", "pattern": "^score_export_[0-9a-f]{24}$"},
    "corpus_index_id": {"type": "string", "pattern": "^corpus_index_[a-z0-9][a-z0-9._-]{0,127}$"},
    "index_sha256": {"$ref": "#/$defs/hash"},
    "policy_snapshot_sha256": {"$ref": "#/$defs/hash"},
    "exported_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "audience": {"enum": ["operator", "researcher"]},
    "operation": {"const": "score_generation"},
    "documents": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/document"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "label": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"},
    "featureValue": {"type": "string", "format": "performing-fire-sanitized-text-v1", "minLength": 1, "maxLength": 128, "pattern": "^(?!.*(?:[Xx]-[Aa]mz-|[Ff]ull source prose))(?!.*[\\r\\n])[A-Za-z0-9 .,!?;'\"()\\[\\]{}_+\\-\\u00B7\\u00C0-\\u024F\\u1E00-\\u1EFF\\u3001\\u3002\\u300C\\u300D\\u3040-\\u3098\\u309B-\\u30FF\\u3400-\\u4DBF\\u4E00-\\u9FFF\\uAC00-\\uD7A3\\u2013\\u2014\\u2018-\\u201D\\u2026\\uFF08\\uFF09]+$"},
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index_document_id", "source_id", "asset_id", "selection_state", "coverage_state", "duplicate_cluster_id", "features", "derived_object_keys"],
      "properties": {
        "index_document_id": {"type": "string", "pattern": "^index_document_[a-z0-9][a-z0-9._-]{0,127}$"},
        "source_id": {"type": "string", "pattern": "^(?:source_[a-z0-9][a-z0-9._-]{0,127}|[a-z]+(?:-[a-z]+)*)$"},
        "asset_id": {"type": "string", "pattern": "^asset_[a-z0-9][a-z0-9._-]{0,127}$"},
        "selection_state": {"enum": ["inventory_only", "selected_rich_corpus", "excluded", "unresolved"]},
        "coverage_state": {"enum": ["selected_contribution", "unselected_candidate", "outside_coverage_targets"]},
        "duplicate_cluster_id": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^duplicate_cluster_[a-z0-9][a-z0-9._-]{0,127}$"}]},
        "features": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/feature"}},
        "derived_object_keys": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/derivedObjectKey"}}
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_id", "name", "origin_class", "provenance_edge_id", "visibility_policy_id", "rights_snapshot_sha256", "consent_snapshot_sha256", "value_sha256", "value_length", "value"],
      "properties": {
        "field_id": {"type": "string", "pattern": "^field_[a-z0-9][a-z0-9._-]{0,127}$"},
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
        "origin_class": {"enum": ["factual_source_metadata", "derived_observation", "generated_score", "project_native"]},
        "provenance_edge_id": {"type": "string", "pattern": "^provenance_edge_[a-z0-9][a-z0-9._-]{0,159}$"},
        "visibility_policy_id": {"type": "string", "pattern": "^visibility_policy_[a-z0-9][a-z0-9._-]{0,159}$"},
        "rights_snapshot_sha256": {"$ref": "#/$defs/hash"},
        "consent_snapshot_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
        "value_sha256": {"$ref": "#/$defs/hash"},
        "value_length": {"type": "integer", "minimum": 1, "maximum": 256},
        "value": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/featureValue"}]}
      }
    },
    "derivedObjectKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transformation_id", "object_key", "sha256", "byte_size", "media_type"],
      "properties": {
        "transformation_id": {"type": "string", "pattern": "^transform_[a-z0-9][a-z0-9._-]{0,127}$"},
        "object_key": {"type": "string", "maxLength": 512, "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[a-z0-9][a-z0-9._/-]{0,511}/v1/derived/(?:source_[a-z0-9._-]+|[a-z]+(?:-[a-z]+)*)/asset_[a-z0-9._-]+/transform_[a-z0-9._-]+/[0-9a-f]{64}$"},
        "sha256": {"$ref": "#/$defs/hash"},
        "byte_size": {"type": "integer", "minimum": 0},
        "media_type": {"type": "string", "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,63}/[a-z0-9][a-z0-9!#$&^_.+-]{0,63}$"}
      }
    }
  }
}
