{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://performing-fire-corpus.invalid/schemas/v1/ocr-result.json",
  "title": "Content-free OCR layout and token facts v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "result_id",
    "operation",
    "job_id",
    "profile_id",
    "profile_version",
    "profile_sha256",
    "source_id",
    "asset_id",
    "input_object_key",
    "input_sha256",
    "output_object_key",
    "output_sha256",
    "output_byte_size",
    "output_media_type",
    "tool_id",
    "tool_class",
    "tool_version",
    "contract_version",
    "parameters_sha256",
    "pages",
    "word_count",
    "line_count",
    "requested_language",
    "detected_language",
    "mean_confidence_milli",
    "minimum_observed_confidence_milli",
    "quality_state",
    "rights_snapshot_sha256",
    "retention_class",
    "retrieval_decision",
    "redaction_state",
    "interpretation",
    "source_excerpt_retention",
    "model_trace_retention",
    "evidence_ref",
    "observed_at",
    "result_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "ocr_result"},
    "result_id": {"type": "string", "pattern": "^ocrresult_[a-z0-9]{24}$"},
    "operation": {"const": "ocr"},
    "job_id": {"type": "string", "pattern": "^derivedjob_[a-z0-9]{24}$"},
    "profile_id": {
      "type": "string",
      "pattern": "^profile_[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "profile_version": {"type": "integer", "minimum": 1},
    "profile_sha256": {"$ref": "#/$defs/hash"},
    "source_id": {
      "type": "string",
      "pattern": "^(?:source_[a-z0-9][a-z0-9._-]{0,127}|[a-z]+(?:-[a-z]+)*)$"
    },
    "asset_id": {
      "type": "string",
      "pattern": "^asset_[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "input_object_key": {"$ref": "#/$defs/object_key"},
    "input_sha256": {"$ref": "#/$defs/hash"},
    "output_object_key": {"$ref": "#/$defs/object_key"},
    "output_sha256": {"$ref": "#/$defs/hash"},
    "output_byte_size": {"type": "integer", "minimum": 1, "maximum": 1073741824},
    "output_media_type": {"$ref": "#/$defs/media_type"},
    "tool_id": {
      "type": "string",
      "pattern": "^tool_[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "tool_class": {"$ref": "#/$defs/label"},
    "tool_version": {"$ref": "#/$defs/version"},
    "contract_version": {"type": "integer", "minimum": 1},
    "parameters_sha256": {"$ref": "#/$defs/hash"},
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page_index",
          "width_px",
          "height_px",
          "block_count",
          "line_count",
          "word_count",
          "mean_confidence_milli"
        ],
        "properties": {
          "page_index": {"type": "integer", "minimum": 0, "maximum": 4095},
          "width_px": {"type": "integer", "minimum": 1, "maximum": 100000},
          "height_px": {"type": "integer", "minimum": 1, "maximum": 100000},
          "block_count": {"type": "integer", "minimum": 0, "maximum": 100000},
          "line_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
          "word_count": {"type": "integer", "minimum": 0, "maximum": 10000000},
          "mean_confidence_milli": {"$ref": "#/$defs/confidence"}
        }
      }
    },
    "word_count": {"type": "integer", "minimum": 0, "maximum": 100000000},
    "line_count": {"type": "integer", "minimum": 0, "maximum": 100000000},
    "requested_language": {"$ref": "#/$defs/nullable_language"},
    "detected_language": {"$ref": "#/$defs/nullable_language"},
    "mean_confidence_milli": {"$ref": "#/$defs/confidence"},
    "minimum_observed_confidence_milli": {"$ref": "#/$defs/confidence"},
    "quality_state": {
      "enum": ["accepted", "low_confidence", "unsupported_language"]
    },
    "rights_snapshot_sha256": {"$ref": "#/$defs/hash"},
    "retention_class": {
      "enum": ["project_native_expiring", "selected_derived"]
    },
    "retrieval_decision": {
      "enum": ["approved", "metadata_only", "blocked"]
    },
    "redaction_state": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "interpretation": {"const": "model_output_not_ground_truth"},
    "source_excerpt_retention": {"const": "none"},
    "model_trace_retention": {"const": "none"},
    "evidence_ref": {"$ref": "#/$defs/evidence_ref"},
    "observed_at": {"$ref": "#/$defs/time"},
    "result_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "confidence": {"type": "integer", "minimum": 0, "maximum": 1000},
    "time": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "label": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
    "version": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}(?:[-+][a-z0-9.-]+)?$"
    },
    "media_type": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,63}/[a-z0-9][a-z0-9!#$&^_.+-]{0,63}$"
    },
    "object_key": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[a-z0-9][a-z0-9._/-]{0,511}$"
    },
    "nullable_language": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[a-z]{2,3}(?:-[a-z0-9]{2,8}){0,3}$"}
      ]
    }
  }
}
