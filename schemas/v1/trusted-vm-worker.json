{
  "$id": "https://performing-fire-corpus.invalid/schemas/v1/trusted-vm-worker.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "capability": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "items": {"pattern": "^[a-z][a-z0-9-]{0,63}$", "type": "string"},
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "expires_at": {"format": "date-time", "pattern": "Z$", "type": "string"},
        "issued_at": {"format": "date-time", "pattern": "Z$", "type": "string"},
        "max_concurrency": {"const": 1},
        "maximum_asset_bytes": {"minimum": 1, "type": "integer"},
        "record_type": {"const": "trusted_vm_worker_capability"},
        "schema_version": {"const": 1},
        "worker_id": {"pattern": "^worker_[a-z0-9][a-z0-9._-]{0,127}$", "type": "string"}
      },
      "required": ["capabilities", "expires_at", "issued_at", "max_concurrency", "maximum_asset_bytes", "record_type", "schema_version", "worker_id"],
      "type": "object"
    },
    "checkpoint": {
      "additionalProperties": false,
      "properties": {
        "job_id": {"$ref": "#/$defs/jobId"},
        "lease_id": {"$ref": "#/$defs/leaseId"},
        "object_key": {"$ref": "#/$defs/objectKey"},
        "record_type": {"const": "trusted_vm_worker_checkpoint"},
        "schema_version": {"const": 1},
        "sequence": {"minimum": 1, "type": "integer"},
        "stage": {"enum": ["authority_confirmed", "exact_key_verified"]}
      },
      "required": ["job_id", "lease_id", "record_type", "schema_version", "sequence", "stage"],
      "type": "object"
    },
    "heartbeat": {
      "additionalProperties": false,
      "properties": {
        "expires_at": {"format": "date-time", "pattern": "Z$", "type": "string"},
        "heartbeat_at": {"format": "date-time", "pattern": "Z$", "type": "string"},
        "job_id": {"$ref": "#/$defs/jobId"},
        "lease_id": {"$ref": "#/$defs/leaseId"},
        "record_type": {"const": "trusted_vm_worker_heartbeat"},
        "schema_version": {"const": 1},
        "worker_id": {"pattern": "^worker_[a-z0-9][a-z0-9._-]{0,127}$", "type": "string"}
      },
      "required": ["expires_at", "heartbeat_at", "job_id", "lease_id", "record_type", "schema_version", "worker_id"],
      "type": "object"
    },
    "id": {"pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$", "type": "string"},
    "job": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {"pattern": "^asset_[a-z0-9][a-z0-9._-]{0,127}$", "type": "string"},
        "evidence_id": {"$ref": "#/$defs/id"},
        "expected_mime_type": {"pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$", "type": "string"},
        "job_id": {"$ref": "#/$defs/jobId"},
        "maximum_bytes": {"minimum": 1, "type": "integer"},
        "policy_expires_at": {"format": "date-time", "pattern": "Z$", "type": "string"},
        "policy_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "record_type": {"const": "trusted_vm_acquisition_job"},
        "required_capabilities": {
          "items": {"pattern": "^[a-z][a-z0-9-]{0,63}$", "type": "string"},
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "rights_id": {"$ref": "#/$defs/id"},
        "run_plan_id": {"$ref": "#/$defs/id"},
        "schema_version": {"const": 1},
        "selection_id": {"$ref": "#/$defs/id"},
        "source_id": {"pattern": "^[a-z][a-z0-9-]{2,127}$", "type": "string"},
        "source_locator_id": {"$ref": "#/$defs/id"},
        "target_object_key": {"$ref": "#/$defs/objectKey"}
      },
      "required": ["asset_id", "evidence_id", "expected_mime_type", "job_id", "maximum_bytes", "policy_expires_at", "policy_snapshot_sha256", "record_type", "required_capabilities", "rights_id", "run_plan_id", "schema_version", "selection_id", "source_id", "source_locator_id", "target_object_key"],
      "type": "object"
    },
    "jobId": {"pattern": "^job_[a-z0-9][a-z0-9._-]{0,127}$", "type": "string"},
    "lease": {
      "additionalProperties": false,
      "properties": {
        "acquired_at": {"format": "date-time", "pattern": "Z$", "type": "string"},
        "expires_at": {"format": "date-time", "pattern": "Z$", "type": "string"},
        "job_id": {"$ref": "#/$defs/jobId"},
        "lease_id": {"$ref": "#/$defs/leaseId"},
        "record_type": {"const": "trusted_vm_worker_lease"},
        "schema_version": {"const": 1},
        "worker_id": {"pattern": "^worker_[a-z0-9][a-z0-9._-]{0,127}$", "type": "string"}
      },
      "required": ["acquired_at", "expires_at", "job_id", "lease_id", "record_type", "schema_version", "worker_id"],
      "type": "object"
    },
    "leaseId": {"pattern": "^lease_[a-z0-9][a-z0-9._-]{0,127}$", "type": "string"},
    "objectKey": {
      "pattern": "^performing-fire/v1/raw/[a-z0-9-]+/asset_[a-z0-9][a-z0-9._-]{0,127}/[0-9a-f]{64}$",
      "type": "string"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "byte_size": {"minimum": 1, "type": "integer"},
        "downstream_job_ids": {
          "items": {"$ref": "#/$defs/jobId"},
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "job_id": {"$ref": "#/$defs/jobId"},
        "lease_id": {"$ref": "#/$defs/leaseId"},
        "object_key": {"$ref": "#/$defs/objectKey"},
        "object_receipt_id": {"$ref": "#/$defs/id"},
        "provenance_receipt_id": {"$ref": "#/$defs/id"},
        "record_type": {"const": "trusted_vm_worker_result"},
        "schema_version": {"const": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "status": {"const": "completed"}
      },
      "required": ["byte_size", "downstream_job_ids", "job_id", "lease_id", "object_key", "object_receipt_id", "provenance_receipt_id", "record_type", "schema_version", "sha256", "status"],
      "type": "object"
    },
    "blocker": {
      "additionalProperties": false,
      "properties": {
        "affected_gate": {"pattern": "^[a-z][a-z0-9_]{0,63}$", "type": "string"},
        "job_id": {"$ref": "#/$defs/jobId"},
        "lease_id": {"$ref": "#/$defs/leaseId"},
        "next_safe_action": {"maxLength": 256, "minLength": 1, "type": "string"},
        "outcome_code": {"pattern": "^[a-z][a-z0-9_]{0,63}$", "type": "string"},
        "record_type": {"const": "trusted_vm_worker_blocker"},
        "required_authority_class": {"const": "corpus_operator"},
        "resume_token": {"pattern": "^resume_[0-9a-f]{24}$", "type": "string"},
        "schema_version": {"const": 1},
        "status": {"const": "blocked"}
      },
      "required": ["affected_gate", "job_id", "lease_id", "next_safe_action", "outcome_code", "record_type", "required_authority_class", "resume_token", "schema_version", "status"],
      "type": "object"
    },
    "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
  },
  "oneOf": [
    {"$ref": "#/$defs/capability"},
    {"$ref": "#/$defs/job"},
    {"$ref": "#/$defs/lease"},
    {"$ref": "#/$defs/heartbeat"},
    {"$ref": "#/$defs/checkpoint"},
    {"$ref": "#/$defs/result"},
    {"$ref": "#/$defs/blocker"}
  ],
  "title": "Trusted-VM supervised worker contracts v1"
}
