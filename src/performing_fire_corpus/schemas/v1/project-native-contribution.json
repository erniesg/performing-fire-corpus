{
  "$id": "https://performing-fire-corpus.invalid/schemas/v1/project-native-contribution.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "id": {
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
      "type": "string"
    },
    "idArray": {
      "items": {"$ref": "#/$defs/id"},
      "type": "array",
      "uniqueItems": true
    },
    "objectKey": {
      "maxLength": 512,
      "pattern": "^performing-fire/v1/(?:raw|derived)/project-native-[a-z-]+/contribution_[a-z0-9._-]+/[0-9a-f]{64}$",
      "type": "string"
    },
    "operation": {
      "enum": [
        "derived_processing",
        "indexing",
        "metadata_inventory",
        "public_retrieval",
        "retention",
        "score_generation",
        "search_visibility",
        "subject_export"
      ]
    }
  },
  "additionalProperties": false,
  "properties": {
    "allowed_audiences": {"$ref": "#/$defs/idArray"},
    "allowed_uses": {
      "items": {"$ref": "#/$defs/operation"},
      "type": "array",
      "uniqueItems": true
    },
    "cache_entry_ids": {"$ref": "#/$defs/idArray"},
    "confidentiality_class": {
      "enum": ["public", "restricted", "sensitive"]
    },
    "consent_ids": {
      "items": {
        "pattern": "^consent_[a-z0-9][a-z0-9._-]{0,127}$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "consent_notice_version": {"$ref": "#/$defs/id"},
    "consent_state": {
      "enum": ["active", "expired", "pending", "revoked"]
    },
    "contribution_id": {
      "pattern": "^contribution_[a-z0-9][a-z0-9._-]{0,127}$",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "data_class": {
      "enum": [
        "artist_submission",
        "generated_score",
        "performer_annotation",
        "performer_choice",
        "visitor_input",
        "visual_system_history",
        "visual_system_state"
      ]
    },
    "deletion_state": {
      "enum": ["active", "deleted", "legal_hold_review", "pending"]
    },
    "derived_object_keys": {
      "items": {"$ref": "#/$defs/objectKey"},
      "type": "array",
      "uniqueItems": true
    },
    "export_policy": {"enum": ["none", "subject_copy"]},
    "index_document_ids": {"$ref": "#/$defs/idArray"},
    "input_contribution_ids": {
      "items": {
        "pattern": "^contribution_[a-z0-9][a-z0-9._-]{0,127}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "legal_hold_id": {
      "anyOf": [
        {
          "pattern": "^legal_hold_[a-z0-9][a-z0-9._-]{0,127}$",
          "type": "string"
        },
        {"type": "null"}
      ]
    },
    "provenance_id": {
      "pattern": "^provenance_[a-z0-9][a-z0-9._-]{0,127}$",
      "type": "string"
    },
    "purpose_code": {"$ref": "#/$defs/id"},
    "raw_object_keys": {
      "items": {"$ref": "#/$defs/objectKey"},
      "type": "array",
      "uniqueItems": true
    },
    "record_type": {"const": "project_native_contribution"},
    "retention_expires_at": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "schema_version": {"const": 1},
    "score_export_ids": {"$ref": "#/$defs/idArray"},
    "source_id": {
      "pattern": "^project-native-[a-z]+(?:-[a-z]+)*$",
      "type": "string"
    },
    "subject_ref": {
      "anyOf": [
        {
          "pattern": "^subject_[a-z0-9][a-z0-9._-]{0,127}$",
          "type": "string"
        },
        {"type": "null"}
      ]
    },
    "system_provenance_id": {
      "anyOf": [
        {
          "pattern": "^system_provenance_[a-z0-9][a-z0-9._-]{0,127}$",
          "type": "string"
        },
        {"type": "null"}
      ]
    },
    "withdrawal_state": {"enum": ["current", "withdrawn"]}
  },
  "required": [
    "allowed_audiences",
    "allowed_uses",
    "cache_entry_ids",
    "confidentiality_class",
    "consent_ids",
    "consent_notice_version",
    "consent_state",
    "contribution_id",
    "created_at",
    "data_class",
    "deletion_state",
    "derived_object_keys",
    "export_policy",
    "index_document_ids",
    "input_contribution_ids",
    "legal_hold_id",
    "provenance_id",
    "purpose_code",
    "raw_object_keys",
    "record_type",
    "retention_expires_at",
    "schema_version",
    "score_export_ids",
    "source_id",
    "subject_ref",
    "system_provenance_id",
    "withdrawal_state"
  ],
  "title": "Project-native contribution lifecycle record v1",
  "type": "object"
}
